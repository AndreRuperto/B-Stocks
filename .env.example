# =============================================================
# B-STOCKS MONOREPO — PRODUCTION & LOCAL ENVIRONMENT VARIABLES
# =============================================================

# --- BACKEND (NestJS + Prisma + PostgreSQL) ---
# Connection string do banco PostgreSQL (Render, Supabase, Neon ou Local)
DATABASE_URL="postgresql://usuario:senha@host:5432/bstocks?sslmode=require"
PORT=3001
NODE_ENV="production"

# CORS: Deixe "*" ou informe o domínio do frontend (ex: https://b-stocks.vercel.app)
CORS_ORIGIN="*"

# Tokens e Chaves de API (Opcionais / Recomendados)
BRAPI_TOKEN="seu_token_brapi_opcional"
GEMINI_API_KEY="sua_chave_gemini_para_teses_ia"
GROQ_API_KEY="sua_chave_groq_fallback_opcional"

# --- FRONTEND (Next.js 14) ---
# URL da API do backend em produção (com prefixo /api)
NEXT_PUBLIC_API_URL="https://b-stocks-backend.onrender.com/api"

