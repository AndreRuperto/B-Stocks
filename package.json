{
  "name": "b-stocks",
  "version": "1.0.0",
  "private": true,
  "description": "B-Stocks - Terminal de Inteligência Fundamentalista & Valuation da B3",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start:backend": "npm --prefix backend run start:prod",
    "start:frontend": "npm --prefix frontend run start",
    "seed:backend": "npm --prefix backend run seed:prod",
    "prisma:push": "npm --prefix backend run prisma:push",
    "test:backend": "npm --prefix backend run test",
    "test:frontend": "npm --prefix frontend run test:e2e"
  }
}

